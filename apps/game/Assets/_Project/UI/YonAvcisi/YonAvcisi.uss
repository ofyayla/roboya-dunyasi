.screen {
    flex-grow: 1;
    background-color: var(--c-bg);
    padding: 12px 20px 16px 20px;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 112px;
}

.top-bar__side {
    flex-direction: row;
    align-items: center;
    width: 240px;
}

.top-bar__side--right {
    justify-content: flex-end;
}

.icon-button--hint {
    background-color: rgb(250, 200, 50);
}

.progress {
    flex-direction: row;
    align-items: center;
}

.progress__dot {
    width: 18px;
    height: 18px;
    margin: 0 6px;
    border-radius: 9px;
    background-color: var(--c-bg-deep);
}

.progress__dot--done {
    background-color: var(--c-forest);
}

.progress__dot--current {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 4px;
    border-color: var(--c-brand);
}

.board-host {
    flex-grow: 1;
    margin: 8px 0;
}

.board {
    flex-grow: 1;
}

/* Oblique board: ground drawn in code, pieces positioned by BoardView in panel units. */
.board__ground,
.board__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.piece,
.piece__shadow,
.trail-dot {
    position: absolute;
    left: 0;
    top: 0;
}

.piece__shadow {
    border-radius: 999px;
    background-color: rgba(58, 42, 29, 0.22);
}

.piece--block {
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(58, 42, 29);
    background-color: rgb(122, 84, 52);
}

.trail-dot {
    border-radius: 999px;
    background-color: rgba(242, 140, 40, 0.55);
}

.piece--collected {
    display: none;
}

.bottom-bar {
    flex-direction: row;
    align-items: center;
    height: 132px;
    padding: 8px 12px;
    border-radius: 24px;
    background-color: var(--c-bg-deep);
}

.palette {
    flex-shrink: 0;
    flex-direction: row;
    padding-right: 12px;
    margin-right: 12px;
    border-right-width: 4px;
    border-color: rgba(0, 0, 0, 0.12);
}

.plan {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
}

.plan--locked .card {
    opacity: 0.85;
}

/* Slots shrink for long plans but never below the 64 dp child touch target. */
.slot {
    flex-basis: 96px;
    flex-shrink: 1;
    min-width: 64px;
    height: 96px;
    margin: 0 2px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.1);
    background-color: rgba(255, 255, 255, 0.55);
    align-items: center;
    justify-content: center;
}

.slot--active {
    border-color: rgb(255, 255, 255);
    border-width: 6px;
    scale: 1.08 1.08;
}

.slot--error {
    border-color: rgb(214, 80, 92);
    border-width: 6px;
}

.slot--hint {
    border-color: rgb(250, 200, 50);
    border-width: 6px;
}

.slot--insert {
    border-left-color: var(--c-brand);
    border-left-width: 10px;
}

.slot > .card {
    width: 100%;
    margin: 0;
}

.play-host {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.icon-button--play {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    padding: 26px;
    background-color: rgb(84, 168, 84);
}

.drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Result over the outro story scene: stars in the sky, buttons bottom-right, characters stay visible. */
.result {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 28px 40px 36px 40px;
}

.result__panel {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}

.result__stars {
    flex-direction: row;
    padding: 12px 28px;
    border-radius: 48px;
    background-color: rgba(255, 244, 226, 0.92);
}

.result__star {
    width: 120px;
    height: 120px;
    margin: 0 8px;
}

.result__buttons {
    flex-direction: row;
    align-self: flex-end;
}

/* Sprite art (F0-17). */
.screen--art {
    -unity-background-scale-mode: scale-and-crop;
}

.sprite {
    -unity-background-scale-mode: scale-to-fit;
}

.screen--art .progress {
    padding: 6px 12px;
    border-radius: 24px;
    background-color: rgba(255, 244, 226, 0.85);
}

.screen--art .bottom-bar {
    background-color: rgba(252, 226, 190, 0.94);
}

/* Bal Peşinde, young level: the bee's memory is invisible. The strip shows blank round dots, so only the count shows. */
.plan--memory .card {
    background-color: rgb(240, 200, 90);
    border-radius: 44px;
    -unity-background-image-tint-color: transparent;
}

.plan--memory .card > * {
    opacity: 0;
}

/* Goal badge (what to collect), shown as pictures over the top of the board. */
.goal-badge {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.goal-badge__item {
    width: 72px;
    height: 72px;
    margin: 0 6px;
    padding: 6px;
    border-radius: 36px;
    background-color: rgba(255, 244, 226, 0.9);
    border-width: 4px;
    border-color: rgba(58, 42, 29, 0.35);
    opacity: 0.55;
    -unity-background-scale-mode: scale-to-fit;
}

.goal-badge__item--done {
    opacity: 1;
    border-color: rgb(94, 148, 67);
    background-color: rgb(235, 250, 220);
}

/* Hata avcısı: ready-made cards stay in a wooden "from the box" frame until the child changes them. */
.slot--box {
    border-width: 4px;
    border-color: rgb(138, 90, 59);
    background-color: rgb(232, 200, 150);
}

#box-mark {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 30px;
    height: 30px;
}

/* Bal Peşinde: the bee's back buttons. Direction buttons sit in a honey panel; "Git" (green) and "Temizle" (red) are big and apart. */
.palette--bee {
    padding: 4px 10px;
    border-radius: 28px;
    background-color: rgba(244, 200, 80, 0.95);
    border-right-width: 0;
}

.icon-button--clear-big {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    padding: 22px;
    margin-right: 16px;
    background-color: rgb(205, 84, 84);
}

/* Plan trace (Minik): the cells the plan would step on, drawn like soft shadows on the ground. */
.trace-mark {
    position: absolute;
    left: 0;
    top: 0;
}

.trace-stop {
    border-radius: 999px;
    border-width: 5px;
    border-color: rgba(255, 255, 255, 0.85);
    background-color: rgba(255, 255, 255, 0.18);
}

.trace-step {
    border-radius: 999px;
    background-color: rgba(40, 60, 30, 0.38);
}
