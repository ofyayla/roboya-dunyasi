.screen {
    flex-grow: 1;
    background-color: var(--c-bg);
    padding: 12px 20px 16px 20px;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 112px;
}

.top-bar__side {
    flex-direction: row;
    align-items: center;
    width: 240px;
}

.top-bar__side--right {
    justify-content: flex-end;
}

.icon-button--hint {
    background-color: rgb(250, 200, 50);
}

.board-host {
    flex-grow: 1;
    margin: 8px 0;
}

.board {
    flex-grow: 1;
}

/* Oblique board: ground drawn in code, pieces positioned by BoardView in panel units. */
.board__ground,
.board__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.piece,
.piece__shadow,
.trail-dot {
    position: absolute;
    left: 0;
    top: 0;
}

.piece__shadow {
    border-radius: 999px;
    background-color: rgba(58, 42, 29, 0.22);
}

.piece--block {
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(58, 42, 29);
    background-color: rgb(122, 84, 52);
}

.trail-dot {
    border-radius: 999px;
    background-color: rgba(242, 140, 40, 0.55);
}

.piece--collected {
    display: none;
}

.bottom-bar {
    flex-direction: row;
    align-items: center;
    height: 132px;
    padding: 8px 12px;
    border-radius: 24px;
    background-color: var(--c-bg-deep);
}

.palette {
    flex-shrink: 0;
    flex-direction: row;
    padding-right: 12px;
    margin-right: 12px;
    border-right-width: 4px;
    border-color: rgba(0, 0, 0, 0.12);
}

.plan {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
}

.plan--locked .card {
    opacity: 0.85;
}

/* Slots shrink for long plans but never below the 64 dp child touch target. */
.slot {
    flex-basis: 96px;
    flex-shrink: 1;
    min-width: 64px;
    height: 96px;
    margin: 0 2px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.1);
    background-color: rgba(255, 255, 255, 0.55);
    align-items: center;
    justify-content: center;
}

.slot--active {
    border-color: rgb(255, 255, 255);
    border-width: 6px;
    scale: 1.08 1.08;
}

.slot--error {
    border-color: rgb(214, 80, 92);
    border-width: 6px;
}

.slot--hint {
    border-color: rgb(250, 200, 50);
    border-width: 6px;
}

.slot--insert {
    border-left-color: var(--c-brand);
    border-left-width: 10px;
}

.slot > .card {
    width: 100%;
    margin: 0;
}

.play-host {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.icon-button--play {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    padding: 26px;
    background-color: rgb(84, 168, 84);
}

.drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Result over the outro story scene: stars in the sky, buttons bottom-right, characters stay visible. */
.result {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 28px 40px 36px 40px;
}

.result__panel {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}

.result__stars {
    flex-direction: row;
    padding: 12px 28px;
    border-radius: 48px;
    background-color: rgba(255, 244, 226, 0.92);
}

.result__star {
    width: 120px;
    height: 120px;
    margin: 0 8px;
}

.result__buttons {
    flex-direction: row;
    align-self: flex-end;
}

/* Sprite art (F0-17). */
.screen--art {
    -unity-background-scale-mode: scale-and-crop;
}

.sprite {
    -unity-background-scale-mode: scale-to-fit;
}

.screen--art .bottom-bar {
    background-color: rgba(252, 226, 190, 0.94);
}

/* Bal Peşinde, young level: the bee's memory is invisible. The strip shows blank round dots, so only the count shows. */
.plan--memory .card {
    background-color: rgb(240, 200, 90);
    border-radius: 44px;
    -unity-background-image-tint-color: transparent;
}

.plan--memory .card > * {
    opacity: 0;
}

/* Goal badge (what to collect), shown as pictures over the top of the board. */
.goal-badge {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.goal-badge__item {
    width: 72px;
    height: 72px;
    margin: 0 6px;
    padding: 6px;
    border-radius: 36px;
    background-color: rgba(255, 244, 226, 0.9);
    border-width: 4px;
    border-color: rgba(58, 42, 29, 0.35);
    opacity: 0.55;
    -unity-background-scale-mode: scale-to-fit;
}

.goal-badge__item--done {
    opacity: 1;
    border-color: rgb(94, 148, 67);
    background-color: rgb(235, 250, 220);
}

/* Hata avcısı: ready-made cards stay in a wooden "from the box" frame until the child changes them. */
.slot--box {
    border-width: 4px;
    border-color: rgb(138, 90, 59);
    background-color: rgb(232, 200, 150);
}

#box-mark {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 30px;
    height: 30px;
}

/* Bal Peşinde: the bee's back buttons. Direction buttons sit in a honey panel; "Git" (green) and "Temizle" (red) are big and apart. */
.palette--bee {
    padding: 4px 10px;
    border-radius: 28px;
    background-color: rgba(244, 200, 80, 0.95);
    border-right-width: 0;
}

.icon-button--clear-big {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    padding: 22px;
    margin-right: 16px;
    background-color: rgb(205, 84, 84);
}

/* Plan trace (Minik): the cells the plan would step on, drawn like soft shadows on the ground. */
.trace-mark {
    position: absolute;
    left: 0;
    top: 0;
}

.trace-stop {
    border-radius: 999px;
    border-width: 5px;
    border-color: rgba(255, 255, 255, 0.85);
    background-color: rgba(255, 255, 255, 0.18);
}

.trace-pick {
    border-radius: 999px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.55);
}

.trace-predict {
    border-radius: 999px;
    border-width: 7px;
    border-color: rgb(70, 130, 220);
    background-color: rgba(70, 130, 220, 0.22);
}

.trace-step {
    border-radius: 999px;
    background-color: rgba(40, 60, 30, 0.38);
}

/* Patience value moment: a calm card with the wise turtle alone. */
.value-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(244, 236, 214);
}

.value-card__turtle {
    width: 420px;
    height: 420px;
}

.value-card__turtle > * {
    width: 100%;
    height: 100%;
}

/* The calm card of a region whose friend is a picture (the village's old bee) rather than the code-drawn turtle. */
.value-card__friend {
    -unity-background-scale-mode: scale-to-fit;
}

.value-card__film {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(244, 236, 214);
}

/* Paylaşım Köyü: hives and the table on the board, with slots that fill as honey arrives (ADR 0030). */
.hive__slots {
    position: absolute;
    left: 0;
    right: 0;
    top: -6%;
    flex-direction: row;
    justify-content: center;
}

.hive__slot {
    margin: 0 1px;
    border-radius: 999px;
    border-width: 3px;
    border-color: rgb(120, 72, 20);
    background-color: rgba(255, 244, 226, 0.35);
}

/* Solid disc against a hollow ring: the count is told by shape, not colour alone. */
.hive__slot--filled {
    background-color: rgb(247, 178, 26);
    border-color: rgb(120, 72, 20);
}

.piece--drop-fallback {
    border-radius: 999px;
    border-width: 5px;
    border-color: rgb(120, 72, 20);
    background-color: rgb(236, 190, 90);
}

.piece--hive-full.piece--drop-fallback {
    background-color: rgb(247, 178, 26);
}

.piece--hive-spill.piece--drop-fallback {
    border-color: rgb(190, 90, 40);
}

/* Ari's basket (top left of the board). */
.basket-view {
    position: absolute;
    top: 4px;
    left: 8px;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 6px 6px;
    border-radius: 40px;
    background-color: rgba(255, 244, 226, 0.9);
    border-width: 3px;
    border-color: rgba(58, 42, 29, 0.35);
}

.basket-view__icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.basket-view__icon--fallback {
    border-radius: 28px;
    border-width: 4px;
    border-color: rgb(120, 72, 20);
    background-color: rgb(210, 160, 90);
}

.basket-view__dots {
    flex-direction: row;
    flex-wrap: wrap;
    max-width: 160px;
    margin-left: 6px;
}

.basket-view__dot {
    width: 18px;
    height: 18px;
    margin: 2px;
    border-radius: 999px;
    border-width: 3px;
    border-color: rgb(120, 72, 20);
    background-color: rgba(255, 244, 226, 0.2);
}

.basket-view__dot--filled {
    background-color: rgb(247, 178, 26);
}

/* "Bırak": bigger than the direction cards and set apart in the bee's honey panel (child target well above 64 dp). */
.palette--bee .card--drop {
    width: 104px;
    height: 104px;
    margin-left: 20px;
    padding: 18px;
}

/* End-of-run comparison of the hive families (plan D3): bee, hive and slots side by side, no digits. */
.hive-compare {
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.hive-compare__panel {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    padding: 10px 18px;
    border-radius: 36px;
    background-color: rgba(255, 244, 226, 0.92);
    border-width: 4px;
    border-color: rgba(58, 42, 29, 0.35);
}

.hive-compare__family {
    align-items: center;
    margin: 0 14px;
}

.hive-compare__villager {
    width: 104px;
    height: 104px;
    -unity-background-scale-mode: scale-to-fit;
}

.hive-compare__villager--fallback {
    border-radius: 52px;
    border-width: 4px;
    border-color: rgb(120, 72, 20);
    background-color: rgb(247, 205, 90);
}

.hive-compare__villager--sad {
    opacity: 0.85;
}

.hive-compare__hive {
    width: 92px;
    height: 92px;
    -unity-background-scale-mode: scale-to-fit;
}

.hive-compare__hive--fallback {
    border-radius: 46px;
    border-width: 4px;
    border-color: rgb(120, 72, 20);
    background-color: rgb(236, 190, 90);
}

.hive-compare__slots {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.hive-compare__slot {
    width: 18px;
    height: 18px;
}

/* Honey goals in the goal badge: a hive with its slots, hives side by side with an equal sign, the basket to keep. */
.goal-badge__hive {
    align-items: center;
    justify-content: flex-end;
    width: 88px;
    height: 88px;
    -unity-background-scale-mode: scale-to-fit;
}

.goal-badge__hive--fallback {
    border-radius: 44px;
    background-color: rgb(236, 190, 90);
    border-color: rgb(120, 72, 20);
}

.goal-badge__slots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: -6px;
}

.goal-badge__slot {
    width: 14px;
    height: 14px;
    border-width: 2px;
}

.goal-badge__equal {
    justify-content: center;
    align-self: center;
}

.goal-badge__equal > * {
    width: 30px;
    height: 7px;
    margin: 3px 0;
    border-radius: 4px;
    background-color: rgb(120, 72, 20);
}

/* "Kaç kaldı?" (plan D4): three dot cards over the board; a wrong tap is never red, Ari counts the right one. */
.remaining {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(244, 236, 214, 0.9);
}

.remaining__basket {
    width: 150px;
    height: 150px;
    margin-bottom: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.remaining__basket--fallback {
    border-radius: 75px;
    border-width: 6px;
    border-color: rgb(120, 72, 20);
    background-color: rgb(210, 160, 90);
}

.remaining__cards {
    flex-direction: row;
    justify-content: center;
}

.remaining__card {
    width: 190px;
    height: 220px;
    margin: 0 16px;
    padding: 12px;
    align-items: center;
    border-radius: 28px;
    border-width: 5px;
    border-color: rgba(58, 42, 29, 0.35);
    background-color: rgb(255, 250, 236);
}

.remaining__face {
    width: 150px;
    height: 150px;
}

.remaining__dot {
    position: absolute;
    width: 30px;
    height: 30px;
    margin-left: -15px;
    margin-top: -15px;
    border-radius: 999px;
    background-color: rgb(247, 178, 26);
    border-width: 3px;
    border-color: rgb(120, 72, 20);
}

.remaining__dot--counted {
    scale: 1.4 1.4;
}

.remaining__numeral {
    margin-top: 4px;
    font-size: 22px;
    color: rgba(58, 42, 29, 0.6);
    -unity-font-style: bold;
}

.remaining__card--tried {
    opacity: 0.6;
}

.remaining__card--right {
    border-color: rgb(94, 148, 67);
    background-color: rgb(235, 250, 220);
    scale: 1.08 1.08;
}

.remaining__skip {
    position: absolute;
    right: 28px;
    bottom: 24px;
}
