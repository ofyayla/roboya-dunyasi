/* Map scene: island, region path, ship workshop. Child touch targets ≥ 64 dp (CLAUDE.md §7). */
.map-root {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(143, 211, 217);
}

.map-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.map-bar {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 16px;
    flex-direction: row;
    justify-content: space-between;
}

/* Island */
.island__image {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.island__region {
    position: absolute;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.island__region--open {
    border-radius: 999px;
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.95);
}

.island__lock {
    width: 64px;
    height: 64px;
}

.island__robot,
.path__robot {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

/* Path */
.path__scroll {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.path__content {
    position: relative;
}

.stone {
    position: absolute;
    width: 104px;
    align-items: center;
}

.stone__face {
    flex-shrink: 0;
    width: 104px;
    height: 104px;
    padding: 26px;
    border-radius: 52px;
    border-width: 6px;
    border-color: rgb(58, 42, 29);
    background-color: rgb(139, 194, 107);
}

.stone--current .stone__face {
    background-color: var(--c-brand);
    border-color: rgb(255, 255, 255);
    border-width: 8px;
}

.stone--locked .stone__face {
    background-color: rgb(196, 186, 170);
    opacity: 0.7;
}

.stone--grownup .stone__face {
    background-color: rgb(214, 204, 190);
    padding: 22px;
}

.stone__stars {
    flex-direction: row;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: 16px;
    background-color: rgba(255, 244, 226, 0.92);
}

.stone__star {
    width: 26px;
    height: 26px;
}

/* Ship workshop (ILR-03) */
.workshop {
    padding: 110px 40px 28px 40px;
    align-items: center;
}

.workshop__stage {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.workshop__ship {
    width: 480px;
    height: 460px;
}

.workshop__robot {
    width: 190px;
    height: 200px;
    margin-left: -20px;
    -unity-background-scale-mode: scale-to-fit;
}

.workshop__row {
    flex-direction: row;
    margin-top: 12px;
    padding: 12px 16px;
    border-radius: 32px;
    background-color: rgba(255, 244, 226, 0.92);
}

.workshop__tile {
    width: 104px;
    height: 104px;
    margin: 0 6px;
    padding: 12px;
    border-radius: 24px;
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0.08);
    background-color: rgb(252, 226, 190);
    align-items: center;
    justify-content: center;
}

.workshop__tile--earned {
    border-color: rgb(84, 168, 84);
    background-color: rgb(220, 240, 200);
}

.workshop__part {
    position: absolute;
    left: 12px;
    top: 12px;
    right: 12px;
    bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.25;
    -unity-background-image-tint-color: rgb(90, 70, 60);
}

.workshop__tile--earned .workshop__part {
    opacity: 1;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.workshop__lock {
    width: 48px;
    height: 48px;
}

/* Ship parts still to be earned show as faint shapes (workshop only). */
.ship__part--coming {
    opacity: 0.18;
    -unity-background-image-tint-color: rgb(90, 70, 60);
}

/* Grown-up entrance (island only), parental gate and parent area. Adult screens: ≥ 48 dp, here 72. */
.map__grownup {
    position: absolute;
    right: 20px;
    top: 16px;
    width: 72px;
    height: 72px;
    padding: 16px;
    border-radius: 36px;
    background-color: rgb(190, 160, 130);
}

.gate,
.parent {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.gate {
    background-color: rgba(74, 52, 36, 0.6);
}

.gate__card {
    width: 560px;
    padding: 28px 36px;
    border-radius: 32px;
    background-color: var(--c-bg);
    align-items: center;
}

.gate__question {
    font-size: 28px;
    color: var(--c-ink);
    white-space: normal;
    -unity-text-align: middle-center;
}

.gate__digits {
    margin-top: 12px;
    font-size: 64px;
    color: var(--c-brand-dark);
    -unity-font-style: bold;
}

.gate__entered {
    margin-top: 4px;
    min-width: 260px;
    padding: 6px 20px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.8);
    font-size: 44px;
    color: var(--c-ink);
    -unity-text-align: middle-center;
}

.gate__message {
    min-height: 34px;
    margin-top: 8px;
    font-size: 22px;
    color: rgb(168, 52, 64);
    white-space: normal;
    -unity-text-align: middle-center;
}

.gate__pad {
    width: 360px;
    margin-top: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}

.gate__key {
    width: 112px;
    height: 72px;
    margin: 4px;
    border-radius: 20px;
    border-width: 0;
    background-color: var(--c-bg-deep);
    font-size: 34px;
    color: var(--c-ink);
}

.gate__key--confirm {
    background-color: rgb(84, 168, 84);
    color: white;
    font-size: 24px;
}

.gate__cancel,
.parent__back {
    height: 56px;
    margin-top: 12px;
    padding: 0 28px;
    border-radius: 28px;
    border-width: 0;
    background-color: rgb(190, 160, 130);
    font-size: 24px;
    color: white;
}

.parent {
    background-color: var(--c-bg);
}

.parent__title {
    font-size: 44px;
    color: var(--c-ink);
    -unity-font-style: bold;
}

.parent__sections {
    margin-top: 16px;
    width: 720px;
    flex-shrink: 1;
}

.parent__empty {
    margin-top: 24px;
    font-size: 26px;
    color: var(--c-ink);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Welcome, notice, profile editor and the profile list (F1-10). Adult screens use 72-unit targets. */
.welcome {
    align-items: center;
    justify-content: center;
}

.welcome__robot {
    width: 420px;
    height: 460px;
    -unity-background-scale-mode: scale-to-fit;
}

.welcome__button {
    position: absolute;
    right: 40px;
    bottom: 40px;
    width: 120px;
    height: 120px;
    margin: 0;
    padding: 26px;
    border-radius: 60px;
    border-width: 6px;
    border-color: white;
    background-color: rgb(190, 160, 130);
}

.editor {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(74, 52, 36, 0.6);
}

.editor__card {
    width: 760px;
    padding: 24px 36px;
    border-radius: 32px;
    background-color: var(--c-bg);
    align-items: center;
}

.notice__card {
    width: 820px;
    height: 720px;
    max-height: 94%;
}

.notice__card .editor__save {
    width: 360px;
}

.notice__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 470px;
    width: 100%;
    margin: 12px 0;
    padding: 12px 16px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.8);
}

.notice__text {
    font-size: 22px;
    color: var(--c-ink);
    white-space: normal;
}

.editor__caption {
    margin-top: 12px;
    align-self: flex-start;
    font-size: 22px;
    color: var(--c-ink);
}

.editor__field {
    width: 100%;
    min-height: 64px;
    margin-top: 4px;
    font-size: 30px;
}

.editor__avatars,
.editor__ages,
.editor__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.editor__avatar {
    width: 88px;
    height: 88px;
    margin: 6px;
    padding: 10px;
    border-radius: 20px;
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.7);
}

.editor__avatar.is-selected,
.editor__age.is-selected {
    border-color: rgb(84, 168, 84);
    background-color: rgb(220, 240, 200);
}

.editor__age {
    min-height: 72px;
    margin: 6px;
    padding: 0 18px;
    border-radius: 20px;
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0.08);
    background-color: var(--c-bg-deep);
    font-size: 22px;
    color: var(--c-ink);
}

.editor__buttons {
    margin-top: 16px;
}

.editor__save {
    width: 220px;
    margin-left: 12px;
}

.section {
    margin-bottom: 16px;
    padding: 16px 20px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.7);
}

.section__title {
    font-size: 30px;
    color: var(--c-ink);
    -unity-font-style: bold;
}

.section__note {
    margin-top: 8px;
    font-size: 20px;
    color: rgb(168, 52, 64);
    white-space: normal;
}

.section__add {
    width: 260px;
    margin-top: 8px;
}

.profile-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding: 8px 12px;
    border-radius: 20px;
    border-width: 4px;
    border-color: transparent;
    background-color: var(--c-bg);
}

.profile-row.is-active {
    border-color: rgb(84, 168, 84);
}

.profile-row__avatar {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

.profile-row__text {
    flex-grow: 1;
    margin-left: 12px;
}

.profile-row__name {
    font-size: 26px;
    color: var(--c-ink);
    -unity-font-style: bold;
}

.profile-row__band {
    font-size: 18px;
    color: var(--c-ink);
}

.profile-row__button {
    min-width: 72px;
    height: 72px;
    margin-left: 8px;
    border-radius: 20px;
    border-width: 0;
    background-color: var(--c-bg-deep);
    font-size: 26px;
    color: var(--c-ink);
}

.profile-row__button--danger {
    background-color: rgb(214, 130, 130);
    color: white;
    font-size: 20px;
}

.rest__robot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320px;
    height: 320px;
    margin-left: -300px;
    margin-top: -190px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}

.rest__battery {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 180px;
    height: 180px;
    margin-left: 40px;
    margin-top: -120px;
}

.report__line {
    margin-top: 6px;
    font-size: 26px;
    color: rgb(74, 51, 36);
    white-space: normal;
}

/* Stones show the game: compass (round), box (rounded square), bee (round with a honey ring). */
.stone--kutu .stone__face {
    border-radius: 22px;
}

.stone--bal .stone__face {
    border-color: rgb(214, 160, 40);
}

.stone--current.stone--bal .stone__face {
    border-color: rgb(255, 255, 255);
}

.stone__part {
    position: absolute;
    top: -10px;
    right: -6px;
    width: 38px;
    height: 38px;
}
