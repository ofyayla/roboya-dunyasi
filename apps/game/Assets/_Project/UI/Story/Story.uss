/* Story scenes (StoryStage): wide shot with large characters; positions are set in code. */
.story {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--c-bg);
}

.story__backdrop,
.story__layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.story__backdrop {
    -unity-background-scale-mode: scale-and-crop;
}

.story__actor,
.story__shadow {
    position: absolute;
    left: 0;
    top: 0;
}

.story__actor {
    -unity-background-scale-mode: scale-to-fit;
}

.story__shadow {
    border-radius: 999px;
    background-color: rgba(58, 42, 29, 0.2);
}

.story__continue {
    position: absolute;
    right: 40px;
    bottom: 36px;
    width: 112px;
    height: 112px;
    margin: 0;
    padding: 26px;
    border-radius: 56px;
    border-width: 6px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(84, 168, 84);
}
