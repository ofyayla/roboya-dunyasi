{
  "name": "@roboya/level-schema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Level JSON schema (single source of truth) and generated TypeScript types",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./level.schema.json"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "validate": "node scripts/validate.mjs ../../content/levels",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4",
    "quicktype": "23.0.176"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
