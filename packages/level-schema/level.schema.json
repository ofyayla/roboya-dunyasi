{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboyakids.com.tr/schemas/level/v1.json",
  "title": "LevelDto",
  "description": "Roboya Dünyası level, schema version 3. Single source of truth for the game, validator and editor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "region",
    "game",
    "order",
    "meta",
    "voice"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "description": "2 adds the optional `story` block (scripts/migrate-v2.mjs). 3 adds `options.intro` (scripts/migrate-v3.mjs).",
      "const": 3
    },
    "id": {
      "description": "Stable id: <region>.<game>.<nn>. Used by progress records; never reuse a deleted id.",
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "region": {
      "$ref": "#/$defs/region"
    },
    "game": {
      "$ref": "#/$defs/game"
    },
    "order": {
      "description": "1-based position on the region path.",
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "grid": {
      "$ref": "#/$defs/grid"
    },
    "robot": {
      "$ref": "#/$defs/robot"
    },
    "items": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "scenery": {
      "description": "Decoration just outside the playable cells (v2), e.g. the tree the narration mentions. x or y is -1 or the grid width/height; never on a walkable cell.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "title": "SceneryDto",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "look"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -1
          },
          "y": {
            "type": "integer",
            "minimum": -1
          },
          "look": {
            "$ref": "#/$defs/obstacleLook"
          }
        }
      }
    },
    "cards": {
      "$ref": "#/$defs/cards"
    },
    "starterProgram": {
      "description": "Pre-filled program (Kodlama Kutusu 'hata avcısı': contains wrong cards to find, KUT-01).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "voice": {
      "$ref": "#/$defs/voice"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "alternativeLevelId": {
      "description": "Easier level offered after repeated failures (YZ-03).",
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "solution": {
      "title": "SolutionDto",
      "description": "Written by the validator (`--fix`); CI fails when it does not match the solver.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortestLength"
      ],
      "properties": {
        "shortestLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sharing": {
      "description": "Köy Meydanı (koy-meydani, ADR 0031): the hives, flowers and Ari's basket of a village level. Replaces grid, robot, goal and cards.",
      "$ref": "#/$defs/sharing"
    }
  },
  "$defs": {
    "region": {
      "title": "RegionId",
      "type": "string",
      "enum": [
        "sabir-ormani",
        "paylasim-koyu",
        "yardimlasma-limani",
        "nezaket-bahcesi",
        "sorumluluk-kulesi",
        "mucit-atolyesi"
      ]
    },
    "game": {
      "title": "GameId",
      "type": "string",
      "enum": [
        "yon-avcisi",
        "kodlama-kutusu",
        "bal-pesinde",
        "dongu-dansi",
        "birlikte-basaralim",
        "robot-atolyesi",
        "serbest-mucit",
        "koy-meydani"
      ]
    },
    "concept": {
      "title": "Concept",
      "type": "string",
      "enum": [
        "direction",
        "sequencing",
        "debugging",
        "loops",
        "conditionals",
        "functions",
        "events",
        "counting"
      ]
    },
    "value": {
      "title": "ValueId",
      "type": "string",
      "enum": [
        "patience",
        "sharing",
        "helping",
        "kindness",
        "responsibility",
        "creativity"
      ]
    },
    "ageLevel": {
      "title": "AgeLevel",
      "type": "string",
      "enum": [
        "minik",
        "kasif",
        "mucit"
      ]
    },
    "meta": {
      "title": "LevelMeta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concepts",
        "value",
        "difficulty",
        "ageLevels"
      ],
      "properties": {
        "concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "ageLevels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ageLevel"
          }
        },
        "mebOutcomes": {
          "description": "MEB curriculum outcome codes (F3-12).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "description": "Internal design notes for the pedagogy team; never shown to children.",
          "type": "string"
        }
      }
    },
    "grid": {
      "title": "GridDto",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "description": "Row 0 is north. '.' floor, '#' blocked. All rows equal length, 2..12.",
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[.#]{2,12}$"
          }
        },
        "looks": {
          "description": "How blocked cells look (v2). Cells not listed get a stable mix of the region's obstacles.",
          "type": "array",
          "maxItems": 144,
          "items": {
            "title": "ObstacleLookDto",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "look"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "look": {
                "$ref": "#/$defs/obstacleLook"
              }
            }
          }
        }
      }
    },
    "position": {
      "title": "PositionDto",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      }
    },
    "direction": {
      "title": "Facing",
      "type": "string",
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ]
    },
    "robot": {
      "title": "RobotDto",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "facing"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "facing": {
          "$ref": "#/$defs/direction"
        }
      }
    },
    "item": {
      "title": "ItemDto",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "flower",
            "honey",
            "gear",
            "star",
            "fruit",
            "ship-part"
          ]
        },
        "color": {
          "description": "Never the only signal: the view pairs every colour with a shape.",
          "type": "string",
          "enum": [
            "red",
            "yellow",
            "blue",
            "green",
            "purple",
            "orange"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      }
    },
    "goal": {
      "title": "GoalDto",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "reach"
          ]
        },
        {
          "required": [
            "collect"
          ]
        }
      ],
      "properties": {
        "reach": {
          "$ref": "#/$defs/position"
        },
        "collect": {
          "description": "Item ids that must all be collected.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "card": {
      "title": "CardId",
      "type": "string",
      "enum": [
        "forward",
        "backward",
        "turn_left",
        "turn_right",
        "repeat",
        "if",
        "call",
        "action"
      ]
    },
    "cards": {
      "title": "CardsDto",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "maxProgramLength"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "maxProgramLength": {
          "description": "Slots on the plan strip.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "introduces": {
          "$ref": "#/$defs/card"
        }
      },
      "description": "Card palette and plan strip. `introduces` names a card presented with a short introduction moment in this level (YON-01)."
    },
    "condition": {
      "title": "ConditionDto",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "path_blocked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "on_color"
            },
            "color": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "inner"
          ],
          "properties": {
            "type": {
              "const": "not"
            },
            "inner": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    },
    "command": {
      "title": "CommandDto",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "enum": [
                "forward",
                "backward",
                "turn_left",
                "turn_right"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "times",
            "body"
          ],
          "properties": {
            "op": {
              "const": "repeat"
            },
            "times": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "condition",
            "then"
          ],
          "properties": {
            "op": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "call"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "action"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "options": {
      "title": "LevelOptions",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ghostPath": {
          "description": "Show the correct route faintly (YON-03).",
          "type": "boolean"
        },
        "beeMemoryVisible": {
          "description": "Bal Peşinde: show the bee's memory strip (Kaşif level).",
          "type": "boolean"
        },
        "predict": {
          "description": "Kodlama Kutusu (KUT-02): before the first run the child taps where the robot will end up; the run is then compared with the guess.",
          "type": "boolean"
        },
        "guided": {
          "description": "Roboya builds the code together with the child (first level of a new concept).",
          "type": "boolean"
        },
        "intro": {
          "description": "Introduction level: a child who starts later on the path still plays it (v3, ADR 0018).",
          "type": "boolean"
        }
      }
    },
    "voiceKey": {
      "title": "VoiceKey",
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "voice": {
      "title": "VoiceDto",
      "description": "Keys into content/voice/script.csv and the localization tables.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro"
      ],
      "properties": {
        "intro": {
          "$ref": "#/$defs/voiceKey"
        },
        "success": {
          "$ref": "#/$defs/voiceKey"
        },
        "hints": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/voiceKey"
          }
        }
      }
    },
    "story": {
      "title": "StoryDto",
      "description": "Wide story scenes before and after the board (PRD principle 2). Narration comes from `voice.intro` and `voice.success`; when a scene is missing the game uses default poses.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "$ref": "#/$defs/storyScene"
        },
        "outro": {
          "$ref": "#/$defs/storyScene"
        }
      }
    },
    "storyScene": {
      "title": "StorySceneDto",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roboya": {
          "title": "RobotPose",
          "description": "Roboya's expression.",
          "type": "string",
          "enum": [
            "front",
            "happy",
            "curious",
            "surprised",
            "proud",
            "laughing"
          ]
        },
        "friend": {
          "title": "FriendPose",
          "description": "Expression of the region character (Sabır Ormanı: Bilge Kaplumbağa).",
          "type": "string",
          "enum": [
            "front",
            "happy",
            "explaining",
            "thanks"
          ]
        },
        "props": {
          "description": "Objects standing between the characters.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "title": "StoryProp",
            "type": "string",
            "enum": [
              "apple",
              "pear",
              "gear",
              "log",
              "tree",
              "bush",
              "rock",
              "bee",
              "flower",
              "honey",
              "beehive",
              "box",
              "magnifier",
              "villager-bee",
              "honeycomb",
              "village-table"
            ]
          }
        }
      }
    },
    "obstacleLook": {
      "title": "ObstacleLook",
      "description": "Region obstacle art; `log` is drawn in code.",
      "type": "string",
      "enum": [
        "tree",
        "rock",
        "bush",
        "log"
      ]
    },
    "sharing": {
      "title": "SharingDto",
      "description": "The village square: no grid and no direction. The child gives Ari a plan of take and give cards (ADR 0031).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hives",
        "goal",
        "limits"
      ],
      "properties": {
        "hives": {
          "description": "The hives that wait for honey, left to right.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "title": "HiveDto",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "need": {
                "description": "Honey the hive asks for (delivery levels); left out when sharing.",
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "has": {
                "description": "Honey the hive already holds at the start.",
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            }
          }
        },
        "flowers": {
          "description": "The honey each flower holds.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "basket": {
          "title": "BasketDto",
          "description": "Ari's basket: honey at the start and the most it holds.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "cap": {
              "description": "The most honey the basket holds; no limit when left out.",
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          }
        },
        "table": {
          "description": "A shared village table: left-over honey goes there.",
          "type": "boolean"
        },
        "goal": {
          "title": "SharingGoalId",
          "description": "deliver: every hive holds what it asks for. share: the hives hold the same and what is left on the table is fewer than the hives.",
          "type": "string",
          "enum": [
            "deliver",
            "share"
          ]
        },
        "amounts": {
          "description": "Give cards carry a count of 1 to 3; otherwise a give card hands over one honey.",
          "type": "boolean"
        },
        "limits": {
          "title": "SharingLimitsDto",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxCards"
          ],
          "properties": {
            "maxCards": {
              "description": "Cards the plan strip holds in all; the cards inside the repeat box count once.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          }
        },
        "repeatBox": {
          "title": "RepeatBoxDto",
          "description": "A fixed repeat box at the head of the strip (corner 4).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slots",
            "maxTurns"
          ],
          "properties": {
            "slots": {
              "description": "Cards that fit inside the box.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "maxTurns": {
              "description": "The most turns the box may run.",
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "predict": {
          "description": "Before the run the child guesses how much honey is left in the basket (corner 3).",
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Grid games (every game but koy-meydani) need grid, robot, goal and cards; the village square (ADR 0031) has no grid and needs `sharing` instead.",
      "if": {
        "required": [
          "game"
        ],
        "properties": {
          "game": {
            "const": "koy-meydani"
          }
        }
      },
      "then": {
        "required": [
          "sharing"
        ],
        "properties": {
          "grid": false,
          "robot": false,
          "items": false,
          "goal": false,
          "scenery": false,
          "cards": false,
          "starterProgram": false
        }
      },
      "else": {
        "required": [
          "grid",
          "robot",
          "goal",
          "cards"
        ],
        "properties": {
          "sharing": false
        }
      }
    }
  ]
}
