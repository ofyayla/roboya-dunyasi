# Copy to .env and fill locally. Never commit .env.
# Values here are synthetic defaults for local Docker Compose only.

# --- API ---
ROBOYA_ENV=local
ROBOYA_DATABASE_URL=postgresql+asyncpg://roboya:roboya@localhost:5432/roboya
ROBOYA_REDIS_URL=redis://localhost:6379/0
ROBOYA_JWT_SECRET=change-me-local-only-change-me-local-only
ROBOYA_FREE_LEVEL_COUNT=3

# --- TTS (tools/tts) — only script text is ever sent ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
